{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"isolatedDeclarations": true,
		"checkJs": false,

		"lib": ["es2022"],
		"module": "preserve",
		"target": "es2022",
		"allowImportingTsExtensions": true,
		"allowArbitraryExtensions": false,
		"exactOptionalPropertyTypes": false,

		"types": ["@types/node"]
	},
	"include": ["src/**/*.ts"]
}
