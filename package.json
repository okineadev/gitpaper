{
	"name": "gitpaper",
	"version": "0.0.2",
	"description": "📰 The first ever generator of non-boring and actually detailed release notes",
	"keywords": [
		"changelog",
		"github",
		"release notes"
	],
	"license": "MIT",
	"author": "Okinea Dev <hi@okinea.dev> (https://github.com/okineadev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/okineadev/gitpaper.git"
	},
	"funding": "https://github.com/okineadev/gitpaper?sponsor=1",
	"bin": {
		"gitpaper": "./dist/cli/gitpaper.mjs"
	},
	"files": [
		"dist/",
		"dist"
	],
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"./cli/gitpaper": {
			"import": "./dist/cli/gitpaper.mjs"
		},
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint:oxc": "oxlint",
		"lint:spell": "cspell --gitignore .",
		"lint": "bun run lint:oxc && bun run lint:spell",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "bun test",
		"preversion": "bun run format && git add .",
		"build": "bunup",
		"dev": "bunup --watch",
		"prepare": "husky"
	},
	"dependencies": {
		"@ai-sdk/google": "^2.0.11",
		"@octokit/rest": "^22.0.0",
		"ai": "^5.0.29",
		"c12": "^3.2.0",
		"commander": "^14.0.0",
		"execa": "^9.6.0",
		"flat-cache": "^6.1.14",
		"handlebars": "^4.7.8",
		"scule": "^1.3.0"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@commitlint/types": "^21.2.0",
		"@octokit/types": "^15.0.0",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.3.0",
		"bun-types": "^1.2.21",
		"bunup": "0.15.3",
		"console-fail-test": "^0.6.1",
		"cspell": "^9.2.1",
		"eslint-plugin-perfectionist": "^5.10.1",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^5.9.2"
	}
}
